          "create_if_missing": true
        },
        "management_mode": {
          "type": "select",
          "required": true,
          "default": "myjdownloader-headless",
          "options": [
            "myjdownloader-headless",
            "web-gui"
          ]
        },
        "myjdownloader_email": {
          "type": "email",
          "required_when": {
            "field": "management_mode",
