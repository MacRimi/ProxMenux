        "config_storage": {
          "type": "storage-selector",
          "required": true,
          "content_types": [
            "rootdir"
          ],
          "description": "Volumen gestionado por Proxmox para /config e incluido en vzdump."
        },
        "config_size_gb": {
          "type": "integer",
          "required": true,
          "default": 4,
          "minimum": 2
