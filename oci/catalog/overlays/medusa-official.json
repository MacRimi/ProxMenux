{
  "proxmox": {
    "installer_profile": {
      "volume_preparations": [
        {
          "container_path": "/config",
          "remove_lost_found": true,
          "owner_strategy": "mapped-root",
          "only_when_mount_type": "managed-volume"
        },
        {
          "container_path": "/downloads",
          "remove_lost_found": true,
          "owner_strategy": "mapped-root",
          "only_when_mount_type": "managed-volume"
        },
        {
          "container_path": "/tv",
          "remove_lost_found": true,
          "owner_strategy": "mapped-root",
          "only_when_mount_type": "managed-volume"
        },
        {
          "container_path": "/anime",
          "remove_lost_found": true,
          "owner_strategy": "mapped-root",
          "only_when_mount_type": "managed-volume"
        }
      ]
    }
  },
  "catalog_ui": {
    "tagline": {
      "en_US": "Medusa is an automatic video library manager for television shows."
    },
    "description": {
      "en_US": "Medusa is an automatic video library manager for television shows. It monitors for new episodes of configured shows and automates searching, downloading, and post-processing across supported torrent and NZB indexers. It also manages metadata, renames and sorts video files, and handles subtitle searches."
    },
    "repository": "https://github.com/pymedusa/Medusa"
  }
}
