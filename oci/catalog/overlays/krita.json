{
  "proxmox": {
    "installer_profile": {
      "selkies": {
        "base": "FROM ghcr.io/linuxserver/baseimage-selkies:debiantrixie",
        "dockerfile_url": "https://raw.githubusercontent.com/linuxserver/docker-krita/master/Dockerfile",
        "dockerfile_sha256": "fc2b53881d92760de6ae19281175cfc73966986ce47ec673e2ef275827aa83d1",
        "reviewed_on": "2026-09-16",
        "documentation": "https://docs.linuxserver.io/images/docker-baseimage-selkies/",
        "nvidia": "not-offered-until-specific-host-and-image-validation",
        "validation": "profile-generated; real streaming workload pending"
      },
      "volume_preparations": [
        {
          "container_path": "/config",
          "remove_lost_found": true,
          "owner_strategy": "mapped-root",
          "only_when_mount_type": "managed-volume"
        }
      ]
    },
    "defaults": {
      "cores": 4,
      "memory_mb": 6144
    }
  },
  "catalog_ui": {
    "tagline": {
      "en_US": "Krita is a professional FREE and open source painting program. It is made by artists that want to see affordable art tools for everyone."
    },
    "description": {
      "en_US": "Krita is a professional open source digital painting application designed by artists. It provides tools for digital illustration, concept art, comic creation, and sketching. The software aims to make versatile, high-grade creative tools accessible to everyone."
    },
    "tips": [
      "Copy and paste between your computer and the streamed desktop, including images, works over HTTPS: port 3001 or an HTTPS reverse proxy. Browsers block clipboard access over plain HTTP."
    ],
    "launch": {
      "scheme": "https",
      "port": 3001,
      "path": "/"
    }
  },
  "environment_additions": [
    {
      "name": "SELKIES_ENABLE_BINARY_CLIPBOARD",
      "example": "true",
      "required": true,
      "sensitive": false,
      "prompt_user": false,
      "source": "proxmenux-overlay"
    }
  ],
  "first_run": {
    "endpoints": [
      {
        "label": "Web UI",
        "scheme": "https",
        "port": 3001,
        "path": "/",
        "source": "linuxserver-readme-application-setup"
      }
    ]
  }
}
