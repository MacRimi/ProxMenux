{
  "first_run": {
    "credentials": [
      {
        "label": "Grocy (new installation; restored data keeps its credentials)",
        "type": "static-default",
        "username": "admin",
        "password": "admin",
        "change_required": true,
        "source": "https://docs.linuxserver.io/images/docker-grocy/"
      }
    ]
  },
  "proxmox": {
    "installer_profile": {
      "volume_preparations": [
        {
          "container_path": "/config",
          "remove_lost_found": true,
          "owner_strategy": "mapped-root",
          "only_when_mount_type": "managed-volume"
        }
      ]
    }
  }
}
