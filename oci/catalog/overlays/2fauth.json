{
  "container_contract": {
    "environment": [
      {
        "name": "APP_KEY",
        "example": "",
        "required": true,
        "sensitive": true,
        "source": "2fauth-env-example"
      }
    ]
  },
  "proxmox": {
    "installer_profile": {
      "generated_sensitive_environment": {
        "APP_KEY": {
          "strategy": "token-hex",
          "bytes": 16,
          "prompt": true
        }
      },
      "volume_preparations": [
        {
          "container_path": "/2fauth",
          "remove_lost_found": true,
          "owner_strategy": "mapped-application-user",
          "only_when_mount_type": "managed-volume"
        }
      ],
      "volume_owner": {
        "uid": 1000,
        "gid": 1000
      },
      "tmpfs_mounts": [
        {
          "id": "2fauth-nginx-run",
          "container_path": "/run/nginx",
          "default_size_mb": 8,
          "minimum_size_mb": 1,
          "prompt_size": false,
          "mount_options": [
            "rw",
            "nosuid",
            "nodev",
            "mode=0777"
          ]
        }
      ]
    }
  },
  "catalog_ui": {
    "tagline": {
      "en_US": "2FAuth is a web based self-hosted alternative to One Time Passcode (OTP) generators like Google Authenticator, designed for both mobile and desktop."
    },
    "description": {
      "en_US": "2FAuth is a web-based alternative to One Time Passcode generators designed for mobile and desktop use. It allows users to store and manage two-factor authentication accounts and tokens. The application stores its account data in an SQLite database."
    },
    "repository": "https://github.com/Bubka/2fauth",
    "screenshots": [
      "https://user-images.githubusercontent.com/858858/100485897-18c21400-3102-11eb-9c72-ea0b1b46ef2e.png"
    ]
  }
}
