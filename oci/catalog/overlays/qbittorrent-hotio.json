{
  "first_run": {
    "credentials": [
      {
        "label": "Temporary login",
        "type": "runtime-generated",
        "username": "admin",
        "password": null,
        "change_required": true,
        "source": "qbittorrent-temporary-password-on-first-start",
        "retrieval": {
          "method": "container-console-pattern",
          "pattern_id": "linuxserver-temporary-password",
          "timeout_seconds": 180
        }
      }
    ]
  },
  "proxmox": {
    "installer_profile": {
      "volume_preparations": [
        {
          "container_path": "/config",
          "remove_lost_found": true,
          "owner_strategy": "mapped-root",
          "only_when_mount_type": "managed-volume"
        },
        {
          "container_path": "/DATA",
          "remove_lost_found": true,
          "owner_strategy": "mapped-root",
          "only_when_mount_type": "managed-volume"
        }
      ]
    }
  }
}
