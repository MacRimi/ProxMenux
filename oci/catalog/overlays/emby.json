{
  "proxmox": {
    "installer_profile": {
      "volume_preparations": [
        {
          "container_path": "/config",
          "remove_lost_found": true,
          "owner_strategy": "mapped-root",
          "only_when_mount_type": "managed-volume"
        },
        {
          "container_path": "/data/tvshows",
          "remove_lost_found": true,
          "owner_strategy": "mapped-root",
          "only_when_mount_type": "managed-volume"
        },
        {
          "container_path": "/data/movies",
          "remove_lost_found": true,
          "owner_strategy": "mapped-root",
          "only_when_mount_type": "managed-volume"
        },
        {
          "container_path": "/opt/vc/lib",
          "remove_lost_found": true,
          "owner_strategy": "mapped-root",
          "only_when_mount_type": "managed-volume"
        }
      ]
    }
  },
  "catalog_ui": {
    "tagline": {
      "en_US": "Emby Server is a personal media server that organizes personal videos, music, and photos into a centralized library."
    },
    "description": {
      "en_US": "Emby Server is a personal media server that organizes personal videos, music, and photos into a centralized library. It converts and streams multimedia content to connected client devices across local networks or the internet. The platform includes a web interface for browsing collections, managing metadata, and playing back media across supported devices."
    },
    "screenshots": [
      "https://raw.githubusercontent.com/MediaBrowser/MediaBrowser.Resources/master/apps/html5.png",
      "https://raw.github.com/MediaBrowser/MediaBrowser.Resources/master/apps/roku2.jpg",
      "https://raw.github.com/MediaBrowser/MediaBrowser.Resources/master/apps/dashboard.png",
      "https://emby.media/resources/universal-live-tv-guide-full.webp"
    ]
  }
}
