{
  "catalog_ui": {
    "launch": {
      "port": null
    },
    "title": {
      "en_US": "faster-whisper"
    },
    "tagline": {
      "en_US": "Faster-whisper is a reimplementation of OpenAI's Whisper model using CTranslate2, which is a fast inference engine for Transformer models. This container provides a Wyoming protocol server for faster-whisper."
    },
    "description": {
      "en_US": "Faster-whisper is an implementation of OpenAI's Whisper model powered by CTranslate2, a fast inference engine for Transformer models. It provides a Wyoming protocol server for speech-to-text transcription. The service is designed to process audio and convert spoken language into text locally with high efficiency."
    }
  },
  "first_run": {
    "endpoints": []
  },
  "proxmox": {
    "installer_profile": {
      "volume_preparations": [
        {
          "container_path": "/config",
          "remove_lost_found": true,
          "owner_strategy": "mapped-root",
          "only_when_mount_type": "managed-volume"
        }
      ],
      "hardware_acceleration": {
        "prompt": "Acceleration for Faster Whisper",
        "default": "cpu",
        "profiles": [
          {
            "id": "cpu",
            "label": "CPU",
            "image": {
              "reference": "lscr.io/linuxserver/faster-whisper:latest",
              "registry": "lscr.io",
              "repository": "lscr.io/linuxserver/faster-whisper",
              "tag": "latest",
              "digest": null,
              "pull_policy": "resolve-selected-tag-to-architecture-digest-at-install"
            },
            "device_requests": []
          },
          {
            "id": "nvidia",
            "label": "NVIDIA (CUDA)",
            "architectures": [
              "amd64"
            ],
            "image": {
              "reference": "lscr.io/linuxserver/faster-whisper:gpu",
              "registry": "lscr.io",
              "repository": "lscr.io/linuxserver/faster-whisper",
              "tag": "gpu",
              "digest": null,
              "pull_policy": "resolve-selected-tag-to-architecture-digest-at-install"
            },
            "device_requests": [
              {
                "id": "nvidia-runtime",
                "kind": "nvidia-runtime",
                "purpose": "nvidia-cuda",
                "device_selection": "all-requested-by-compose"
              }
            ],
            "environment": [
              {
                "name": "NVIDIA_VISIBLE_DEVICES",
                "value": "all"
              },
              {
                "name": "NVIDIA_DRIVER_CAPABILITIES",
                "value": "compute,utility"
              }
            ]
          }
        ]
      }
    },
    "defaults": {
      "cores": 2,
      "memory_mb": 4096
    }
  }
}
