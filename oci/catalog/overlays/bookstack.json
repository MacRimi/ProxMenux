        "source": "linuxserver-compose"
      },
      {
        "name": "DB_PORT",
        "example": "3306",
        "required": true,
        "sensitive": false,
        "source": "linuxserver-compose"
      },
      {
        "name": "DB_USERNAME",
        "example": "",
        "required": true,
