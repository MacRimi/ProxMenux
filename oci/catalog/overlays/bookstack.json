        "source": "linuxserver-compose"
      },
      {
        "name": "DB_PASSWORD",
        "example": "",
        "required": true,
        "sensitive": true,
        "source": "linuxserver-compose"
      },
      {
        "name": "DB_DATABASE",
        "example": "",
        "required": true,
        "sensitive": false,
        "source": "linuxserver-compose"
      },
      {
        "name": "QUEUE_CONNECTION",
        "example": "",
        "required": false,
        "sensitive": false,
        "source": "linuxserver-compose"
      }
    ]
  },
  "first_run": {
    "credentials": [
      {
        "label": "BookStack web interface",
        "type": "static-default",
        "username": "admin@admin.com",
        "password": "password",
        "change_required": true,
        "source": "linuxserver-readme-application-setup",
        "retrieval": null
      }
    ]
  },
  "proxmox": {
    "installer_profile": {
      "generated_sensitive_environment": {
        "APP_KEY": {
          "strategy": "token-hex",
          "bytes": 16,
          "prompt": true
        }
      },
      "volume_preparations": [
        {
          "container_path": "/config",
          "remove_lost_found": true,
          "owner_strategy": "mapped-root",
          "only_when_mount_type": "managed-volume"
        }
      ],
      "external_services": [
        "MariaDB"
      ]
    }
  },
  "environment_overrides": {
    "APP_URL": {
      "prompt": "Address BookStack will be opened at (for example http://192.168.1.50:6875)"
    },
    "DB_HOST": {
      "prompt": "Address of the MariaDB server"
    },
    "DB_USERNAME": {
      "prompt": "User of the MariaDB server"
    },
    "DB_DATABASE": {
      "prompt": "Name of the database on the MariaDB server"
    },
    "DB_PASSWORD": {
      "prompt": "Password of the MariaDB user"
    }
  }
}
