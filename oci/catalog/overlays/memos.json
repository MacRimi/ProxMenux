{
  "container_contract": {
    "image": {
      "reference": "neosmemo/memos:stable",
      "tag": "stable"
    }
  },
  "proxmox": {
    "installer_profile": {
      "volume_preparations": [
        {
          "container_path": "/var/opt/memos",
          "remove_lost_found": true,
          "owner_strategy": "mapped-root",
          "only_when_mount_type": "managed-volume"
        }
      ]
    }
  }
}
