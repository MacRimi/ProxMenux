  "first_run": {
    "credentials": [
      {
        "label": "Speedtest Tracker web interface",
        "type": "static-default",
        "username": "admin@example.com",
        "password": "password",
        "change_required": true,
        "source": "linuxserver-readme-application-setup",
        "retrieval": null
      }
    ]
  },
  "proxmox": {
    "installer_profile": {
      "generated_sensitive_environment": {
        "APP_KEY": {
          "strategy": "token-hex",
          "bytes": 16,
          "prompt": true
        }
      },
      "volume_preparations": [
        {
          "container_path": "/config",
          "remove_lost_found": true,
          "owner_strategy": "mapped-root",
          "only_when_mount_type": "managed-volume"
        }
      ]
    }
  },
  "environment_overrides": {
    "APP_URL": {
      "prompt": "Address Speedtest Tracker will be opened at (for example http://192.168.1.50)",
      "container_address": "http://@CONTAINER_ADDRESS@"
    },
    "SPEEDTEST_SCHEDULE": {
      "example": "0 */6 * * *",
      "prompt": "Schedule of the tests in cron format"
    },
    "SPEEDTEST_SERVERS": {
      "required": false,
      "prompt": "Server IDs to test against, separated by commas (optional)"
    }
  },
  "catalog_ui": {
    "tagline": {
      "en_US": "Speedtest-tracker is a self-hosted internet performance tracking application that runs speedtest checks against Ookla's Speedtest service."
    },
    "description": {
      "en_US": "Speedtest Tracker is a self-hosted internet performance tracking application. It runs automated speed tests against Ookla's Speedtest service to monitor download, upload, and latency metrics. Test results are collected over time and presented through a web interface to help observe connection quality and consistency."
    }
  }
}
