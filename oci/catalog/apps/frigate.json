      "cores": 4,
      "cpuset_requirement": "none-for-current-openvino-lxc-repair",
      "memory_mb": 4096,
      "swap_mb": 1024,
      "rootfs_size_gb": 16,
      "rootfs_storage": "local-lvm",
      "volume_storage": "local-lvm",
      "template_storage": "local",
      "bridge": "vmbr0",
      "ipv4": "dhcp",
