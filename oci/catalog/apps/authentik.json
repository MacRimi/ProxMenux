    "adaptations": [
      {
        "id": "worker-docker-socket-removed",
        "upstream_behavior": "The official Compose mounts the Docker socket into the worker for automatic deployment and management of separate outposts.",
        "native_lxc_behavior": "The Docker socket mount is omitted. Authentik itself runs as server, PostgreSQL and worker in native OCI LXCs.",
        "reason": "The ProxMenux native OCI stack does not run Docker Engine or provide a Docker daemon socket.",
        "behavioral_impact": "Use the embedded outpost for a simple proxy-provider deployment, or deploy and manage an outpost separately.",
        "validation": "passed-ms03-2026-10-30"
      },
      {
        "id": "postgres-healthcheck-normalized",
        "upstream_behavior": "The official PostgreSQL healthcheck expands Compose environment variables in its command.",
        "native_lxc_behavior": "The check uses the recipe’s fixed database and username with pg_isready against localhost.",
        "reason": "The native stack healthcheck runs in the database LXC and does not evaluate Compose variable interpolation.",
        "behavioral_impact": "It checks the same local database readiness before dependent services start.",
        "validation": "passed-ms03-postgresql-readiness-2026-10-30"
      },
      {
        "id": "server-worker-shared-data",
        "upstream_behavior": "Authentik server and worker both mount /data and /templates from the same Compose source directories.",
        "native_lxc_behavior": "ProxMenux uses shared host directories for these two paths across the server and worker LXCs.",
        "reason": "The same data and custom templates must be visible to both services; the stack driver shares named Compose sources through host paths.",
        "behavioral_impact": "These shared host directories are not included in native LXC backups and need a separate backup.",
        "validation": "passed-ms03-2026-10-30"
      }
    ],
