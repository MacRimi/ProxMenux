\n      MQTT_HOST: mosquitto\n    image: teslamate/teslamate:latest\n    ports:\n      - 4000:4000\n    restart: unless-stopped\n    volumes:\n      - read_only: false\n        source: import\n        target: /opt/app/import\nvolumes:\n  database: {}\n  grafana: {}\n  import: {}\n  mosquitto-config: {}\n  mosquitto-data: {}\n  mosquitto-log: {}\n"
