      },
      {
        "id": "postgres-major-version",
        "upstream_behavior": "The official deployment selects postgres:18-trixie and persists /var/lib/postgresql.",
        "native_lxc_behavior": "Keep that tag and volume root, including the versioned PostgreSQL data directory.",
        "reason": "Avoid an unintended PostgreSQL major-version change.",
        "behavioral_impact": "Minor image updates remain available within the selected major version.",
        "validation": "passed-ms03-2026-10-29"
      },
      {
        "id": "mosquitto-declared-log-volume",
        "upstream_behavior": "The Mosquitto image declares /mosquitto/log as a data volume in addition to /mosquitto/data.",
        "native_lxc_behavior": "Add a backup-enabled managed volume for /mosquitto/log alongside configuration and data.",
        "reason": "Every OCI-declared data path must survive image replacement.",
        "behavioral_impact": "The MQTT port remains private; no image is rebuilt.",
        "validation": "passed-ms03-2026-10-29"
      },
      {
        "id": "grafana-nested-persistent-data",
        "upstream_behavior": "Grafana stores SQLite at the persistent mount root.",
        "native_lxc_behavior": "Use a data subdirectory, created by a shell entrypoint before executing the original /run.sh.",
        "reason": "Proxmox restores mount roots with root ownership; nested data retains the Grafana user ownership.",
        "behavioral_impact": "Official image and original startup script are retained. Data and plugins remain backed up in the same volume.",
        "validation": "passed-ms03-2026-10-29"
      }
