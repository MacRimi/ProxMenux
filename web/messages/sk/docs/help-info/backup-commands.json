  "header": {
    "title": "Zálohovanie a obnova",
    "description": "Prehľad príkazov vzdump, qmrestore a pct restore pre zálohovanie v Proxmoxe. Obsahuje plánovanie, pokročilé možnosti ako hook skripty, vylúčené cesty a prioritu I/O, ako aj správu súborov záloh.",
    "section": "Pomoc a informácie"
  },
  "intro": {
    "title": "Tri režimy zálohovania",
    "body": "Pri VM je <strong>snapshot</strong> živá záloha bez požiadavky na snímky úložiska. <strong>suspend</strong> VM predtým pozastaví a nemusí zlepšiť konzistentnosť. <strong>stop</strong> ju najprv vypne; predtým bežiaca VM môže pokračovať po začatí zálohy. Pri LXC je to iné: snapshot vyžaduje úložisko so snímkami, suspend používa dva priechody rsync a stop drží kontajner zastavený počas celej zálohy."
  },
  "commandGroups": [
    {
      "title": "Zálohovanie VM",
      "commands": [
        {
          "command": "vzdump <vmid>",
          "description": "Vytvoriť zálohu špecifického VM/CT"
        },
        {
          "command": "vzdump <vmid> --storage <storage>",
          "description": "Zálohovanie VM do špecifického úložiska"
        },
        {
          "command": "vzdump <vmid> --mode snapshot",
          "description": "Vytvoriť zálohu snímok (pre VMs)"
        },
        {
          "command": "vzdump <vmid> --mode suspend",
          "description": "Pozastaviť VM pred živou zálohou, starší režim suspend"
        },
        {
          "command": "vzdump <vmid> --mode stop",
          "description": "Vypnúť VM pred začatím zálohy"
        },
        {
          "command": "vzdump --all",
          "description": "Zálohovať všetky VM a kontajnery"
        },
        {
          "command": "vzdump --all --exclude <vmid1>,<vmid2>",
          "description": "Zálohovať všetko okrem zadaných VM"
        }
      ]
    },
    {
      "title": "Možnosti zálohovania",
      "commands": [
        {
          "command": "vzdump <vmid> --compress zstd",
          "description": "Použiť kompresiu zstd pre zálohovanie"
        },
        {
          "command": "vzdump <vmid> --compress gzip --pigz <threads>",
          "description": "Použiť pigz s viacerými vláknami"
        },
        {
          "command": "vzdump <vmid> --storage <storage> --notes-template <text>",
          "description": "Pridať poznámky k zálohe"
        },
        {
          "command": "vzdump <vmid> --mailto <email>",
          "description": "Poslať notifikáciu e-mail"
        },
        {
          "command": "vzdump <vmid> --prune-backups keep-last=<n>",
          "description": "Udržujte iba n zálohy na VM"
        },
        {
          "command": "vzdump <vmid> --stdexcludes 0",
          "description": "Nevylučujte dočasné súbory"
        },
        {
          "command": "vzdump <vmid> --quiet 1",
          "description": "Potlačiť výstupné správy"
        }
      ]
    },
    {
      "title": "Obnoviť zálohy",
      "commands": [
        {
          "command": "qmrestore <backup-file> <vmid>",
          "description": "Obnoviť VM zo zálohy"
        },
        {
          "command": "qmrestore <backup-file> <vmid> --storage <storage>",
          "description": "Obnoviť na vybrané úložisko"
        },
        {
          "command": "qmrestore <backup-file> <vmid> --unique",
          "description": "Obnoviť VM s novými náhodnými MAC adresami"
        },
        {
          "command": "pct restore <vmid> <backup-file>",
          "description": "Obnoviť kontajner zo zálohy"
        },
        {
          "command": "pct restore <vmid> <backup-file> --storage <storage>",
          "description": "Obnoviť kontajner na vybrané úložisko"
        },
        {
          "command": "pct restore <vmid> <backup-file> --rootfs <storage>:<size-GiB>",
          "description": "Obnoviť s koreňovým diskom na vybranom úložisku a so zvolenou veľkosťou"
        },
        {
          "command": "pct restore <vmid> <backup-file> --unprivileged 1",
          "description": "Obnoviť ako neprivilegovaný CT"
        }
      ]
    },
    {
      "title": "Správa záloh",
      "commands": [
