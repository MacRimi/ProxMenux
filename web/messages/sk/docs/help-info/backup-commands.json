        },
        {
          "command": "rm /var/lib/vz/dump/<backup-file>",
          "description": "Odstrániť zálohovací súbor"
        },
        {
          "command": "cat /etc/vzdump.conf",
          "description": "Zobraziť nastavenie zálohy"
        }
