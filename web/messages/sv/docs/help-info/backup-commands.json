  "header": {
    "title": "Backup och återställ",
    "description": "Curated referens av vzdump, qmrestore och pct återställa kommandon för Proxmox backup arbetsflöden. Inkluderar schemaläggning, avancerade alternativ som krokskript / utesluta vägar / I / O-prioritet och backup-filhantering.",
    "section": "Hjälp och info"
  },
  "intro": {
    "title": "Tre backup lägen",
    "body": "<strong>Snapshot</strong> använder en live-snapshot - gästen stannar igång, kort pausar I / O. <strong>suspend</strong> fryser de VM under backup (säkert än snapshot för non-snapshot-aware FS). <strong>Stopp stopp</strong> Stänger ner VM, backar upp kallt, startar om. Välj med gästtolerans och lagringskapacitet."
  },
  "commandGroups": [
    {
      "title": "VM-säkerhetskopiering",
      "commands": [
        {
          "command": "vzdump <vmid>",
          "description": "Skapa en säkerhetskopia av en specifik VM/CT"
        },
        {
          "command": "vzdump <vmid> --storage <storage>",
          "description": "Backup VM till specifik lagring"
        },
        {
          "command": "vzdump <vmid> --mode snapshot",
          "description": "Skapa snapshot backup (för VM)"
        },
        {
          "command": "vzdump <vmid> --mode suspend",
          "description": "Avbryt VM under backup"
        },
        {
          "command": "vzdump <vmid> --mode stop",
          "description": "Stoppa VM under backup"
        },
        {
          "command": "vzdump --all",
          "description": "Säkerhetskopiera alla VM och behållare"
        },
        {
          "command": "vzdump --exclude <vmid1>,<vmid2>",
          "description": "Säkerhetskopiera alla utom specificerade VM"
        }
      ]
    },
    {
      "title": "Backup alternativ",
      "commands": [
        {
          "command": "vzdump <vmid> --compress zstd",
          "description": "Använd zstd komprimering för backup"
        },
        {
          "command": "vzdump <vmid> --pigz <threads>",
          "description": "Använd pigz med flera trådar"
        },
        {
          "command": "vzdump <vmid> --notes <text>",
          "description": "Lägg till anteckningar till backup"
        },
        {
          "command": "vzdump <vmid> --mailto <email>",
          "description": "Skicka meddelande e-post"
        },
        {
          "command": "vzdump <vmid> --maxfiles <n>",
          "description": "Håll bara n backups per VM"
        },
        {
          "command": "vzdump <vmid> --stdexcludes 0",
          "description": "Undvik inte tillfälliga filer"
        },
        {
          "command": "vzdump <vmid> --quiet 1",
          "description": "Suppress output-meddelanden"
        }
      ]
    },
    {
      "title": "Återställ säkerhetskopior",
      "commands": [
