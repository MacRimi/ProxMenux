  "header": {
    "title": "Säkerhetskopiering och återställning",
    "description": "Kommenterad referens för vzdump, qmrestore och pct restore i Proxmox arbetsflöden för säkerhetskopiering. Omfattar schemaläggning, avancerade alternativ som hookskript, undantagna sökvägar och I/O-prioritet samt hantering av säkerhetskopieringsfiler.",
    "section": "Hjälp och info"
  },
  "intro": {
    "title": "Tre backup lägen",
    "body": "För VM:ar är <strong>snapshot</strong> en livesäkerhetskopiering som inte kräver snapshots i lagringen. <strong>suspend</strong> pausar VM:n före säkerhetskopieringen utan att nödvändigtvis förbättra konsistensen. <strong>stop</strong> stänger först av VM:n; om den kördes kan den återupptas när säkerhetskopieringen har startat. LXC skiljer sig: snapshot kräver lagring med snapshot-stöd, suspend använder två rsync-pass och stop håller containern avstängd under hela säkerhetskopieringen."
  },
  "commandGroups": [
    {
      "title": "VM-säkerhetskopiering",
      "commands": [
        {
          "command": "vzdump <vmid>",
          "description": "Skapa en säkerhetskopia av en specifik VM/CT"
        },
        {
          "command": "vzdump <vmid> --storage <storage>",
          "description": "Backup VM till specifik lagring"
        },
        {
          "command": "vzdump <vmid> --mode snapshot",
          "description": "Skapa snapshot backup (för VM)"
        },
        {
          "command": "vzdump <vmid> --mode suspend",
          "description": "Pausa VM:n före livesäkerhetskopieringen, äldre suspend-läge"
        },
        {
          "command": "vzdump <vmid> --mode stop",
          "description": "Stäng av VM:n innan säkerhetskopieringen startar"
        },
        {
          "command": "vzdump --all",
          "description": "Säkerhetskopiera alla VM och containrar"
        },
        {
          "command": "vzdump --all --exclude <vmid1>,<vmid2>",
          "description": "Säkerhetskopiera alla utom specificerade VM"
        }
      ]
    },
    {
