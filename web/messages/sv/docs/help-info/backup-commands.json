        },
        {
          "command": "pct restore <vmid> <backup-file> --rootfs <storage>",
          "description": "Återställ specifika rootfs"
        },
        {
          "command": "pct restore <vmid> <backup-file> --unprivileged 1",
          "description": "Återställ som oprivilegierad CT"
        }
      ]
    },
