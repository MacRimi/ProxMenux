          "description": "Rinominare un set di dati"
        },
        {
          "command": "zfs get all <pool>/<dataset>",
          "description": "Mostra tutte le proprietà di un set di dati"
        },
        {
          "command": "zfs set compression=on <pool>/<dataset>",
          "description": "Abilitare la compressione su un set di dati"
        }
      ]
    },
    {
      "title": "Gestione snapshot",
      "commands": [
        {
          "command": "zfs list -t snapshot",
          "description": "Elenca tutte le snapshot"
        },
        {
          "command": "zfs list -t snapshot -r <pool>",
          "description": "Elenca tutte le istantanee in un pool"
        },
        {
          "command": "zfs snapshot <pool>/<dataset>@<snapshot-name>",
          "description": "Creare una snapshot"
        },
        {
          "command": "zfs destroy <pool>/<dataset>@<snapshot-name>",
          "description": "Eliminare un'istantanea"
        },
        {
          "command": "zfs rollback <pool>/<dataset>@<snapshot-name>",
          "description": "Rollback a una snapshot"
        },
        {
          "command": "zfs hold <tag> <pool>/<dataset>@<snapshot-name>",
          "description": "Mettere una presa su una snapshot"
        },
        {
          "command": "zfs release <tag> <pool>/<dataset>@<snapshot-name>",
          "description": "Rilasciare una presa su un'istantanea"
        }
      ]
    },
    {
      "title": "Clone e Invia/Riceve",
      "commands": [
        {
          "command": "zfs clone <pool>/<dataset>@<snapshot> <pool>/<clone-name>",
          "description": "Creare un clone da una snapshot"
        },
        {
          "command": "zfs send <pool>/<dataset>@<snapshot> > backup.zfs",
          "description": "Invia una snapshot a un file"
        },
        {
          "command": "zfs receive <pool>/<dataset> < backup.zfs",
          "description": "Ricevi un'istantanea da un file"
        },
        {
          "command": "zfs send -i <pool>/<dataset>@<snap1> <pool>/<dataset>@<snap2> > incr.zfs",
          "description": "Invia istantanee incrementali"
        },
        {
          "command": "zfs send -R <pool>/<dataset>@<snapshot> > full-recursive.zfs",
          "description": "Invia istantanee ricorsive"
        }
      ]
    },
