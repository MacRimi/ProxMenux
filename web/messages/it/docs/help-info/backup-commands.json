        },
        {
          "command": "vzdump <vmid> --stdexcludes 0",
          "description": "Non escludere i file temporanei"
        },
        {
          "command": "vzdump <vmid> --quiet 1",
          "description": "Messaggi di uscita Suppress"
        }
      ]
    },
    {
      "title": "Ripristinare i backup",
