    },
    {
      "title": "Gestione dei backup",
      "commands": [
        {
          "command": "ls -la /var/lib/vz/dump/",
          "description": "Elenca i backup nella posizione predefinita"
        },
        {
          "command": "find /var/lib/vz/dump/ -name \"*.vma*\"",
          "description": "Trova i backup VM"
        },
        {
          "command": "find /var/lib/vz/dump/ -name \"*.tar*\"",
          "description": "Trova i backup dei container"
        },
        {
          "command": "pvesm list <storage>",
          "description": "Elenca i backup in archiviazione specifica"
        },
        {
          "command": "rm /var/lib/vz/dump/<backup-file>",
          "description": "Eliminare un file di backup"
