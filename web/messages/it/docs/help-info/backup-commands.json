  "header": {
    "title": "Backup e ripristino",
    "description": "Riferimento ragionato dei comandi vzdump, qmrestore e pct restore per i backup Proxmox. Include pianificazione, opzioni avanzate come hook script, percorsi da escludere e priorità I/O, oltre alla gestione dei file di backup.",
    "section": "Aiuto e informazioni"
  },
  "intro": {
    "title": "Tre modalità di backup",
    "body": "<strong>snapshot</strong> utilizza un'istantanea live — gli ospiti rimangono in esecuzione, brevemente si ferma I/O. <strong>Suspend</strong> gela il VM durante il backup (salvo che istantanee per non-snapshot-aware FS). <strong>Fermati.</strong> spegne il VM, si alza il freddo, riavvia. Scegli con la tolleranza degli ospiti e la capacità di stoccaggio."
  },
  "commandGroups": [
    {
      "title": "Backup VM",
      "commands": [
        {
          "command": "vzdump <vmid>",
          "description": "Creare un backup di una specifica VM/CT"
        },
        {
          "command": "vzdump <vmid> --storage <storage>",
          "description": "Backup VM per lo storage specifico"
        },
        {
          "command": "vzdump <vmid> --mode snapshot",
          "description": "Crea backup snapshot (per VM)"
        },
        {
          "command": "vzdump <vmid> --mode suspend",
          "description": "Sospendere VM durante il backup"
        },
        {
          "command": "vzdump <vmid> --mode stop",
          "description": "Stop VM durante il backup"
        },
        {
          "command": "vzdump --all",
          "description": "Backup di tutte le VM e contenitori"
        },
        {
          "command": "vzdump --exclude <vmid1>,<vmid2>",
          "description": "Backup tutti tranne VM specificate"
        }
      ]
    },
    {
      "title": "Opzioni di backup",
      "commands": [
